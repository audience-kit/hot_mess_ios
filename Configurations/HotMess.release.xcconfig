//
//  HotMess.release.xcconfig
//  HotMess
//
//  Build settings for the Release configuration. Everything here is surfaced
//  through Info.plist and read back via AppConfiguration.
//

SERVER_SCHEME = https
SERVER_BASE = api.audiencekit.com

// The AudienceKit audience this build talks to. AUDIENCE_HOST goes with
// sign-in (so the API checks the Facebook token against Hot Mess's apps and
// binds the session to the audience) and with the branding lookup.
// hotmess.admin.audiencekit.com resolves by subdomain today; switch to
// hotmess.social once that domain is verified. AUDIENCE_ID is optional.
AUDIENCE_HOST = hotmess.admin.audiencekit.com
AUDIENCE_ID = b0f8b66a-e636-495d-9475-0f5317ea08e0

FACEBOOK_APP_ID = 1168782378316790

AUDIENCEKIT_ENVIRONMENT = production

// Required by Facebook SDK 13 and later. Copy the client token from the
// Facebook app dashboard (Settings -> Advanced -> Client token) for each
// environment; login reports an error at runtime while this is empty.
FACEBOOK_CLIENT_TOKEN =

BUNDLE_SUFFIX = 
APNS_ENVIRONMENT = production

// Apple Pay for cover payments. The merchant ID must be registered in the
// Apple Developer account (Identifiers -> Merchant IDs) and on Stripe
// (Settings -> Payment methods -> Apple Pay) before Apple Pay shows. Leave it
// empty to take cards only.
APPLE_PAY_MERCHANT_ID = merchant.social.hotmess

// Secrets that stay out of git, such as FACEBOOK_CLIENT_TOKEN. Copy
// Local.xcconfig.example to Local.release.xcconfig and fill it in.
#include? "Local.release.xcconfig"

HOTMESS_APP_GROUP = group.social.hotmess
HOTMESS_DISPLAY_NAME = Hot Mess
