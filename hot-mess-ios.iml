<?xml version="1.0" encoding="UTF-8"?>
<!-- Monorepo module for the iOS submodule; build with Xcode. -->
<module type="WEB_MODULE" version="4">
  <component name="NewModuleRootManager" inherit-compiler-output="true">
    <exclude-output />
    <content url="file://$MODULE_DIR$/ios">
      <sourceFolder url="file://$MODULE_DIR$/ios/HotMess" isTestSource="false" />
      <sourceFolder url="file://$MODULE_DIR$/ios/HotMessTests" isTestSource="true" />
      <sourceFolder url="file://$MODULE_DIR$/ios/HotMessUITests" isTestSource="true" />
      <excludeFolder url="file://$MODULE_DIR$/ios/.build" />
      <excludeFolder url="file://$MODULE_DIR$/ios/.swiftpm" />
      <excludeFolder url="file://$MODULE_DIR$/ios/build" />
      <excludeFolder url="file://$MODULE_DIR$/ios/DerivedData" />
    </content>
    <orderEntry type="inheritedJdk" />
    <orderEntry type="sourceFolder" forTests="false" />
  </component>
</module>
